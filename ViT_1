    "# === COLLECT DATA ===\n",
    "data = []\n",
    "for c in TARGET_CLASSES:\n",
    "    cd = os.path.join(PNG_SEGMENTS_DIR, c)\n",
    "    if not os.path.exists(cd): continue\n",
    "    for ecg in tqdm(os.listdir(cd), desc=c):\n",
    "        ep = os.path.join(cd, ecg)\n",

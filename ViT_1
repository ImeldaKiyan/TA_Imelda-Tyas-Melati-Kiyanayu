    "# === PATIENT-WISE SPLIT ===\n",
    "ecg_labels = df.groupby('ecg_id')['label'].first().reset_index()\n",
    "train_val, test_ecg = train_test_split(ecg_labels, test_size=0.2, stratify=ecg_labels['label'], random_state=SEED)\n",
